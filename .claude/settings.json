{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/pttphuc/AppData/Local/Programs/Python/Python314/Scripts/graphify.EXE hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/pttphuc/AppData/Local/Programs/Python/Python314/Scripts/graphify.EXE hook-guard read",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/pttphuc/AppData/Local/Programs/Python/Python314/python.exe -I C:/Work/Project/second-brain/.claude/hooks/graphify_stale.py",
            "timeout": 120,
            "statusMessage": "Checking graphify graph freshness..."
          }
        ]
      }
    ]
  }
}